{
  "name": "cmc-smart-student-assistant",
  "version": "1.0.0",
  "description": "Trợ lý học tập thông minh dành riêng cho sinh viên CMC (chạy cục bộ)",
  "main": "main.js",
  "author": "CMC Student",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "check": "node scripts/check-syntax.js",
    "icon": "node scripts/gen-icon.js",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --win portable"
  },
  "dependencies": {
    "axios": "^1.7.7",
    "docx": "^9.0.3",
    "nodemailer": "^6.9.15",
    "pdf-parse": "^1.1.1"
  },
  "devDependencies": {
    "electron": "^44.4.5",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "vn.cmcu.smartstudent",
    "productName": "CMC Smart Student",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**/*"
    ],
    "win": {
      "target": "portable",
      "icon": "build/icon.png"
    },
    "portable": {
      "artifactName": "CMC-Smart-Student.exe"
    }
  }
}
